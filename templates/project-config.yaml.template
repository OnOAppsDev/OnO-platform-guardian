# Platform Guardian — Project Configuration
# Generated by: guardian init
# Do not edit manually

project:
  name: "{{PROJECT_NAME}}"
  platform: "{{PLATFORM_TYPE}}"  # android-mobile | ios-mobile | apple-tv | android-tv | tizen | webos | vidaa
  team: "{{TEAM_NAME}}"
  created_date: "{{CREATED_DATE}}"

org_knowledge:
  repo_url: "{{ORG_KNOWLEDGE_REPO_URL}}"
  branch: "main"
  last_synced: "{{LAST_SYNC_DATE}}"
  version: "{{ORG_KNOWLEDGE_VERSION}}"

phases:
  p0_environment_setup:
    status: "complete"        # pending | complete | blocked
    completed_date: "{{DATE}}"
    validated_by: "platform-guardian"

  p1_project_registration:
    status: "pending"
    completed_date: null
    platform_constraints_loaded: false

  p2_initial_audit:
    status: "pending"
    completed_date: null
    report_path: ".platform-guardian/audit-report.md"
    critical_blockers_acknowledged: false
    acknowledged_by: null
    acknowledged_date: null

  p3_architecture_analysis:
    status: "pending"
    completed_date: null
    map_path: ".platform-guardian/architecture-map.md"
    deviations_documented: false

  p4_rules_definition:
    status: "pending"
    completed_date: null
    claude_md_generated: false
    approved_by: null
    approved_date: null
    approval_required_from:
      - role: "pm"
        name: "{{PM_NAME}}"
      - role: "tech_lead"
        name: "{{TECH_LEAD_NAME}}"

  p5_development_mode:
    status: "pending"
    activated_date: null
    features_in_progress: []

  p6_release_preparation:
    status: "pending"
    release_version: null
    qa_signoff: false
    cross_platform_check: false

settings:
  min_test_coverage: 80        # percentage — from org-knowledge/qa-process/standards.md
  block_on_missing_spec: true  # block feature dev if spec not in Repo B
  block_on_missing_design: true
  block_unapproved_deps: true
  require_human_gate_p4: true  # cannot automate Phase 4 approval
  audit_log_enabled: true
